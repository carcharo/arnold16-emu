diff --git a/cpcec-a16.h b/cpcec-a16.h
new file mode 100644
index 0000000..a1164b7
--- /dev/null
+++ b/cpcec-a16.h
@@ -0,0 +1,332 @@
+// Arnold 16 additions to CPCEC (GPLv3, like the rest of this file set).
+// Hardware spec: arnold16-docs, spec/hardware-spec-v0.2.md.
+// Everything here is inert unless --arnold16 is given: without it the eight
+// ports answer like any unused port and CPCEC behaves as upstream.
+//
+//   --arnold16          enable the Arnold 16 hardware
+//   --a16-rom FILE      68000 boot ROM image, up to 64 KB (default: arnold16.rom
+//                       beside the emulator)
+//   --a16-serial FILE   write what the 68000 sends to its debug serial port to FILE
+//   --a16-serial-in FILE  feed FILE's bytes to the 68000's serial port; the boot
+//                       ROM loads a program from it (see tools/mkload.py). The
+//                       file is read from its start each time the 68000 starts.
+//   --a16-keys LIST     for tests: press and release CPC keys at given frames.
+//                       LIST is FRAME:KEY:STATE,... with KEY a CPC key number
+//                       and STATE 1 (down) or 0 (up), e.g. 100:47:1,110:47:0
+//
+// What is here: the Z80 ports at &F9E0-&F9E7, the mailbox, a 68000 with RAM,
+// boot ROM and a write-only debug serial port, and the video chip (320x200
+// window on a 512x256 bitmap in 256 colours, scrolling, 32 sprites, frame and
+// raster interrupts). The 68000 is Musashi (Karl Stenerud, MIT licence), built
+// separately and linked in.
+// Serial input has no speed: a byte is there whenever the 68000 looks.
+
+#include <string.h>
+#include <stdio.h>
+#include "m68k.h" // Musashi
+
+// --- Z80 side ------------------------------------------------------------ //
+
+#define A16_PORT_BASE 0xF9E0 // eight ports, all 16 address bits decoded
+#define A16_ID 0x16
+#define A16_CTRL_RUN 1 // CTRL bit 0: 1 releases the 68000 from reset
+#define A16_CTRL_DISPLAY 2 // CTRL bit 1: 1 shows the new video chip (not built yet)
+#define A16_STAT_RUNNING 1 // STATUS bit 0: 68000 is running
+#define A16_STAT_FROM68K 2 // STATUS bit 1: a message from the 68000 is waiting
+#define A16_STAT_TO68K 4 // STATUS bit 2: the last message to the 68000 has not been read
+
+// --- 68000 side ---------------------------------------------------------- //
+
+#define A16_RAM_SIZE 0x100000 // $000000-$0FFFFF main RAM
+#define A16_VRAM_BASE 0xE00000 // $E00000-$E3FFFF video RAM
+#define A16_VRAM_SIZE 0x040000
+#define A16_ROM_BASE 0xF00000 // $F00000-$F0FFFF boot ROM
+#define A16_ROM_SIZE 0x010000
+#define A16_MBOX_CMD 0xFF1001 // read takes the command from the Z80, write sends one
+#define A16_MBOX_STAT 0xFF1003 // bit 0: message from the Z80 waiting; bit 1: last message to the Z80 unread
+#define A16_MBOX_DATA 0xFF1004 // four bytes, $FF1004-$FF1007
+#define A16_SER_DATA 0xFF2001
+#define A16_SER_STAT 0xFF2003 // bit 0: a byte has arrived; bit 1: the port can send
+#define A16_IRQ_MAILBOX 2 // 68000 interrupt levels
+#define A16_IRQ_RASTER 4
+#define A16_IRQ_FRAME 6
+
+// video chip: registers are 16-bit words at $FF0000, high byte first
+#define A16_VREG_BASE 0xFF0000
+#define A16_VID_CTRL 0x0 // bit 0 display on, bit 1 sprites on, bit 2 frame interrupt on, bit 3 raster interrupt on
+#define A16_VID_STAT 0x2 // bit 0 in vertical blank, bit 1 frame interrupt pending, bit 2 raster interrupt pending
+#define A16_SCROLL_X 0x4
+#define A16_SCROLL_Y 0x6
+#define A16_RASTER_LINE 0x8
+#define A16_VCOUNT 0xA
+#define A16_BORDER 0xC
+#define A16_SPRITE_BASE 0xFF0100 // 32 sprites of 8 bytes
+#define A16_PALETTE_BASE 0xFF0200 // 256 entries of 2 bytes, 0RGB
+#define A16_PATTERNS 0x20000 // offset of the sprite patterns in video RAM
+#define A16_LINES 312 // scan lines per frame; lines 0-199 are the picture
+// where the 320x200 picture sits in CPCEC's frame: the place of the standard
+// CPC screen. CPCEC counts 16 units per microsecond across and 2 per line down,
+// so an Arnold 16 pixel (8 MHz) is 2 units wide and 2 units high.
+#define A16_FIRST_X (19<<4)
+#define A16_FIRST_Y (9<<4)
+#define A16_CYCLES_PER_TICK 8 // 68000 at 8 MHz; CPCEC counts time in microseconds (1 tick = 4 Z80 clock cycles)
+
+char a16_enabled=0;
+const char *a16_rom_path=NULL,*a16_serial_path=NULL,*a16_serin_path=NULL,*a16_keys=NULL;
+FILE *a16_serial=NULL,*a16_serin=NULL;
+int a16_serin_byte=-1; // the byte waiting at the serial port, or -1
+long a16_frame_no=0;
+BYTE a16_ctrl; // CTRL register
+BYTE a16_to68k_cmd,a16_to68k_data[4],a16_to68k_full; // Z80 -> 68000 message
+BYTE a16_from68k_cmd,a16_from68k_data[4],a16_from68k_full; // 68000 -> Z80 message
+BYTE a16_ram[A16_RAM_SIZE],a16_vram[A16_VRAM_SIZE],a16_rom[A16_ROM_SIZE];
+char a16_cpu_ready=0,a16_rom_loaded=0;
+BYTE a16_vreg[16],a16_sprites[256],a16_palette[512];
+BYTE a16_vstat; // VID_STAT
+int a16_vcount; // the line being drawn now
+VIDEO_UNIT a16_rgb[256]; // the palette as CPCEC pixels
+#define a16_vword(r) ((a16_vreg[r]<<8)+a16_vreg[(r)+1])
+int a16_cycles; // 68000 cycles owed (or, if negative, run ahead)
+
+void a16_args(int *argc,char **argv) // strip and act on the "--a..." options; everything else is left alone
+{
+	int i=1,o=1; for (;i<*argc;++i)
+	{
+		int v=i+1<*argc;
+		if (!strcmp(argv[i],"--arnold16")) a16_enabled=1;
+		else if (v&&!strcmp(argv[i],"--a16-rom")) a16_rom_path=argv[++i];
+		else if (v&&!strcmp(argv[i],"--a16-serial")) a16_serial_path=argv[++i];
+		else if (v&&!strcmp(argv[i],"--a16-serial-in")) a16_serin_path=argv[++i];
+		else if (v&&!strcmp(argv[i],"--a16-keys")) a16_keys=argv[++i];
+		else argv[o++]=argv[i];
+	}
+	*argc=o;
+}
+
+void a16_irq(void) // work out the 68000's interrupt level; the highest source wins
+{
+	// mailbox: raised until the 68000 reads MBOX_CMD; frame and raster: until it writes 1 to its VID_STAT bit
+	if (!a16_cpu_ready) return;
+	BYTE c=a16_vreg[A16_VID_CTRL+1];
+	m68k_set_irq(((a16_vstat&2)&&(c&4))?A16_IRQ_FRAME:
+		((a16_vstat&4)&&(c&8))?A16_IRQ_RASTER:
+		a16_to68k_full?A16_IRQ_MAILBOX:0);
+}
+
+void a16_palette_set(int i) // palette entry `i` changed: 4 bits each of red, green, blue
+{
+	int r=a16_palette[i*2]&15,g=a16_palette[i*2+1]>>4,b=a16_palette[i*2+1]&15;
+	a16_rgb[i]=video_xlat_rgb((r*17<<16)+(g*17<<8)+b*17);
+}
+
+int a16_serin_peek(void) // is a byte waiting at the serial port?
+{
+	if (a16_serin_byte<0&&a16_serin) a16_serin_byte=fgetc(a16_serin); // EOF is -1 too
+	return a16_serin_byte>=0;
+}
+
+// memory map of the 68000, as Musashi's callbacks; the 68000 is big-endian
+
+unsigned int m68k_read_memory_8(unsigned int a)
+{
+	a&=0xFFFFFF;
+	if (a<8) return a16_rom[a]; // reset vectors come from the boot ROM
+	if (a<A16_RAM_SIZE) return a16_ram[a];
+	if (a>=A16_VRAM_BASE&&a<A16_VRAM_BASE+A16_VRAM_SIZE) return a16_vram[a-A16_VRAM_BASE];
+	if (a>=A16_ROM_BASE&&a<A16_ROM_BASE+A16_ROM_SIZE) return a16_rom[a-A16_ROM_BASE];
+	if (a==A16_MBOX_CMD) { a16_to68k_full=0; a16_irq(); return a16_to68k_cmd; }
+	if (a==A16_MBOX_STAT) return (a16_to68k_full?1:0)+(a16_from68k_full?2:0);
+	if (a>=A16_MBOX_DATA&&a<A16_MBOX_DATA+4) return a16_to68k_data[a-A16_MBOX_DATA];
+	if (a==A16_SER_STAT) return 2+a16_serin_peek(); // can always send
+	if (a==A16_SER_DATA) { int b=a16_serin_peek()?a16_serin_byte:0; a16_serin_byte=-1; return b; }
+	if (a>=A16_VREG_BASE&&a<A16_VREG_BASE+16)
+	{
+		a-=A16_VREG_BASE;
+		if (a==A16_VID_STAT+1) return a16_vstat; // reading changes nothing: see the write side
+		if (a==A16_VID_STAT) return 0;
+		if (a==A16_VCOUNT) return a16_vcount>>8;
+		if (a==A16_VCOUNT+1) return a16_vcount&255;
+		return a16_vreg[a];
+	}
+	if (a>=A16_SPRITE_BASE&&a<A16_SPRITE_BASE+256) return a16_sprites[a-A16_SPRITE_BASE];
+	if (a>=A16_PALETTE_BASE&&a<A16_PALETTE_BASE+512) return a16_palette[a-A16_PALETTE_BASE];
+	return 0; // unlisted addresses read as zero
+}
+void m68k_write_memory_8(unsigned int a,unsigned int b)
+{
+	a&=0xFFFFFF;
+	if (a<A16_RAM_SIZE) a16_ram[a]=b;
+	else if (a>=A16_VRAM_BASE&&a<A16_VRAM_BASE+A16_VRAM_SIZE) a16_vram[a-A16_VRAM_BASE]=b;
+	else if (a==A16_MBOX_CMD) a16_from68k_cmd=b,a16_from68k_full=1;
+	else if (a>=A16_MBOX_DATA&&a<A16_MBOX_DATA+4) a16_from68k_data[a-A16_MBOX_DATA]=b;
+	else if (a==A16_SER_DATA) { if (a16_serial) fputc(b,a16_serial); }
+	else if (a==A16_VREG_BASE+A16_VID_STAT+1) { a16_vstat&=~(b&6); a16_irq(); } // write 1 to clear: bit 1 frame, bit 2 raster
+	else if (a==A16_VREG_BASE+A16_VID_STAT) ; // high byte of VID_STAT: nothing to write
+	else if (a>=A16_VREG_BASE&&a<A16_VREG_BASE+16) { a16_vreg[a-A16_VREG_BASE]=b; a16_irq(); }
+	else if (a>=A16_SPRITE_BASE&&a<A16_SPRITE_BASE+256) a16_sprites[a-A16_SPRITE_BASE]=b;
+	else if (a>=A16_PALETTE_BASE&&a<A16_PALETTE_BASE+512) a16_palette[a-=A16_PALETTE_BASE]=b,a16_palette_set(a>>1);
+}
+unsigned int m68k_read_memory_16(unsigned int a) { return (m68k_read_memory_8(a)<<8)+m68k_read_memory_8(a+1); }
+unsigned int m68k_read_memory_32(unsigned int a) { return (m68k_read_memory_16(a)<<16)+m68k_read_memory_16(a+2); }
+void m68k_write_memory_16(unsigned int a,unsigned int b) { m68k_write_memory_8(a,(b>>8)&255); m68k_write_memory_8(a+1,b&255); }
+void m68k_write_memory_32(unsigned int a,unsigned int b) { m68k_write_memory_16(a,(b>>16)&65535); m68k_write_memory_16(a+2,b&65535); }
+
+void a16_rom_load(void) // once, the first time the 68000 is started
+{
+	char path[STRMAX]; FILE *f;
+	a16_rom_loaded=1;
+	if (a16_rom_path) strcpy(path,a16_rom_path);
+	else strcat(strcpy(path,session_path),"arnold16.rom");
+	if (!(f=fopen(path,"rb")))
+		{ fprintf(stderr,"arnold16: cannot open boot ROM %s\n",path); return; }
+	if (fread(a16_rom,1,A16_ROM_SIZE,f)<8)
+		fprintf(stderr,"arnold16: boot ROM %s is too short\n",path);
+	fclose(f);
+}
+
+void a16_start(void) // RUN went from 0 to 1: the 68000 leaves reset
+{
+	if (!a16_rom_loaded) a16_rom_load();
+	if (a16_serial_path&&!a16_serial) a16_serial=fopen(a16_serial_path,"wb");
+	if (a16_serin_path&&!a16_serin&&!(a16_serin=fopen(a16_serin_path,"rb")))
+		fprintf(stderr,"arnold16: cannot open %s\n",a16_serin_path);
+	if (a16_serin) rewind(a16_serin);
+	a16_serin_byte=-1;
+	if (!a16_cpu_ready)
+		m68k_init(),m68k_set_cpu_type(M68K_CPU_TYPE_68000),a16_cpu_ready=1;
+	{ // RAM and video RAM start full of junk, as real RAM does; the boot ROM clears them.
+		// A fixed sequence, so runs repeat exactly.
+		unsigned int x=0x16A16;
+		for (int i=0;i<(int)sizeof(a16_ram);++i) x=x*1103515245+12345,a16_ram[i]=x>>16;
+		for (int i=0;i<(int)sizeof(a16_vram);++i) x=x*1103515245+12345,a16_vram[i]=x>>16;
+	}
+	memset(a16_vreg,0,sizeof(a16_vreg)); memset(a16_sprites,0,sizeof(a16_sprites)); memset(a16_palette,0,sizeof(a16_palette));
+	for (int i=0;i<256;++i) a16_palette_set(i);
+	a16_vstat=0;
+	m68k_pulse_reset(); a16_cycles=0; a16_irq();
+}
+
+void a16_reset(void) // a CPC reset always returns the machine to a plain CPC
+{
+	a16_ctrl=a16_to68k_full=a16_from68k_full=0;
+	a16_to68k_cmd=a16_from68k_cmd=0;
+	memset(a16_to68k_data,0,4); memset(a16_from68k_data,0,4);
+	a16_irq();
+}
+
+#define a16_port(p) (a16_enabled&&((p)&0xFFF8)==A16_PORT_BASE)
+
+void a16_send(int r,BYTE b) // the Z80 writes register `r` (0-7)
+{
+	switch (r)
+	{
+		case 1: // CTRL
+			b&=A16_CTRL_RUN|A16_CTRL_DISPLAY;
+			if (!(b&A16_CTRL_RUN)) // holding the 68000 in reset empties the mailbox
+				a16_to68k_full=a16_from68k_full=0;
+			else if (!(a16_ctrl&A16_CTRL_RUN))
+				a16_ctrl=b,a16_start();
+			a16_ctrl=b; a16_irq();
+			break;
+		case 3: // MBOX_CMD: send the command, with the data bytes written before it
+			a16_to68k_cmd=b,a16_to68k_full=1; a16_irq();
+			break;
+		case 4: case 5: case 6: case 7: // MBOX_DATA
+			a16_to68k_data[r-4]=b;
+			break;
+	}
+}
+
+BYTE a16_recv(int r) // the Z80 reads register `r` (0-7)
+{
+	switch (r)
+	{
+		case 0: // ID
+			return A16_ID;
+		case 1: // CTRL
+			return a16_ctrl;
+		case 2: // STATUS
+			return ((a16_ctrl&A16_CTRL_RUN)?A16_STAT_RUNNING:0)
+				+(a16_from68k_full?A16_STAT_FROM68K:0)
+				+(a16_to68k_full?A16_STAT_TO68K:0);
+		case 3: // MBOX_CMD: take the waiting command
+			a16_from68k_full=0;
+			return a16_from68k_cmd;
+		default: // MBOX_DATA
+			return a16_from68k_data[r-4];
+	}
+}
+
+void a16_main(int t) // the hardware catches up with the Z80: `t` microseconds have passed
+{
+	if (!a16_enabled||!(a16_ctrl&A16_CTRL_RUN)) return;
+	if ((a16_cycles+=t*A16_CYCLES_PER_TICK)>0)
+		a16_cycles-=m68k_execute(a16_cycles); // it may overshoot by part of an instruction
+}
+
+void a16_draw(VIDEO_UNIT *row,int line) // draw one scan line of the video chip over the CPC's picture
+{
+	VIDEO_UNIT border=a16_rgb[a16_vreg[A16_BORDER+1]],*t=row+VIDEO_OFFSET_X,*z=t+VIDEO_PIXELS_X;
+	BYTE c=a16_vreg[A16_VID_CTRL+1],px[320];
+	if (line<0||line>=200||!(c&1)) // outside the picture, or display off: border only
+		{ while (t<z) *t++=border; return; }
+	const BYTE *b=&a16_vram[((a16_vword(A16_SCROLL_Y)+line)&255)<<9]; int x=a16_vword(A16_SCROLL_X);
+	for (int i=0;i<320;++i) px[i]=b[(x+i)&511]; // the window wraps at the bitmap's edges
+	if (c&2) // sprites: at most 16 on a line, the lowest numbers; a lower number is in front
+	{
+		int n,k=0,list[16];
+		for (n=0;n<32&&k<16;++n)
+		{
+			const BYTE *e=&a16_sprites[n*8]; int y=(short)((e[2]<<8)+e[3]);
+			if ((e[5]&1)&&line>=y&&line<y+16) list[k++]=n;
+		}
+		while (k--)
+		{
+			const BYTE *e=&a16_sprites[list[k]*8]; int sx=(short)((e[0]<<8)+e[1]),r=line-(short)((e[2]<<8)+e[3]);
+			const BYTE *p=&a16_vram[A16_PATTERNS+((e[4]&63)<<8)+(((e[5]&4)?15-r:r)<<4)];
+			for (int i=0;i<16;++i,++sx)
+			{
+				BYTE v=p[(e[5]&2)?15-i:i];
+				if (v&&sx>=0&&sx<320) px[sx]=v; // colour 0 is transparent
+			}
+		}
+	}
+	while (t<row+A16_FIRST_X) *t++=border;
+	for (int i=0;i<320;++i) { VIDEO_UNIT v=a16_rgb[px[i]]; *t++=v; *t++=v; }
+	while (t<z) *t++=border;
+}
+
+void a16_scanline(void) // the CPC has just finished a scan line
+{
+	if (!a16_enabled) return;
+	int line=(frame_pos_y-A16_FIRST_Y)/2; // 0-199 inside the picture
+	if ((a16_ctrl&A16_CTRL_DISPLAY)&&frame_pos_y>=VIDEO_OFFSET_Y&&frame_pos_y<VIDEO_OFFSET_Y+VIDEO_PIXELS_Y&&frame_pos_y==video_pos_y)
+		a16_draw(video_target-video_pos_x,frame_pos_y<A16_FIRST_Y?-1:line);
+	if (!(a16_ctrl&A16_CTRL_RUN)) return;
+	// the next line starts now: count it and raise the events that belong to its start
+	if (++line<0) line+=A16_LINES; // lines above the picture are the end of the last frame
+	a16_vcount=line%=A16_LINES;
+	if (line==200) a16_vstat|=1+2; // the picture has ended: vertical blank, frame interrupt
+	else if (!line) a16_vstat&=~1;
+	if (line==a16_vword(A16_RASTER_LINE)) a16_vstat|=4; // raster interrupt
+	a16_irq();
+}
+
+void a16_frame(void) // once per emulated frame
+{
+	++a16_frame_no;
+	for (const char *k=a16_keys;k&&*k;) // scripted key presses, for tests
+	{
+		long f; int key,down,n=0;
+		if (sscanf(k,"%ld:%d:%d%n",&f,&key,&down,&n)<3) break;
+		if (f==a16_frame_no&&key>=0&&key<80) { if (down) kbd_bit_set(key); else kbd_bit_res(key); }
+		k+=n; if (*k==',') ++k;
+	}
+	if (a16_serial) fflush(a16_serial); // so a watcher of the file sees the output at once
+}
+
+void a16_exit(void)
+{
+	if (a16_serial) fclose(a16_serial),a16_serial=NULL;
+	if (a16_serin) fclose(a16_serin),a16_serin=NULL;
+}
